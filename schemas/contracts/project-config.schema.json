{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pptx-pipeline:schema:project-config:0.1.0",
  "title": "PPTX Pipeline ProjectConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractType",
    "projectId",
    "template",
    "capabilityRegistry",
    "projectOverlay",
    "paths",
    "policies"
  ],
  "properties": {
    "schemaVersion": { "$ref": "urn:pptx-pipeline:schema:shared:0.1.0#/$defs/schemaVersion" },
    "contractType": { "const": "project-config" },
    "projectId": { "$ref": "urn:pptx-pipeline:schema:shared:0.1.0#/$defs/semanticId" },
    "template": { "$ref": "#/$defs/templateReference" },
    "capabilityRegistry": { "$ref": "#/$defs/registryReference" },
    "projectOverlay": { "$ref": "#/$defs/overlayReference" },
    "paths": { "$ref": "#/$defs/projectPaths" },
    "policies": { "$ref": "#/$defs/projectPolicies" }
  },
  "$defs": {
    "templateReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourcePath", "profileId", "profilePath", "indexId", "indexPath"],
      "properties": {
        "sourcePath": {
          "type": "string",
          "minLength": 6,
          "maxLength": 512,
          "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*\\.(?:pptx|potx)$"
        },
        "profileId": { "$ref": "urn:pptx-pipeline:schema:shared:0.1.0#/$defs/semanticId" },
        "profilePath": { "$ref": "urn:pptx-pipeline:schema:shared:0.1.0#/$defs/relativePath" },
        "indexId": { "$ref": "urn:pptx-pipeline:schema:shared:0.1.0#/$defs/semanticId" },
        "indexPath": { "$ref": "urn:pptx-pipeline:schema:shared:0.1.0#/$defs/relativePath" }
      }
    },
    "registryReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registryId", "registryVersion", "path"],
      "properties": {
        "registryId": { "$ref": "urn:pptx-pipeline:schema:shared:0.1.0#/$defs/semanticId" },
        "registryVersion": { "$ref": "urn:pptx-pipeline:schema:shared:0.1.0#/$defs/semanticVersion" },
        "path": { "$ref": "urn:pptx-pipeline:schema:shared:0.1.0#/$defs/relativePath" }
      }
    },
    "overlayReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overlayId", "path"],
      "properties": {
        "overlayId": { "$ref": "urn:pptx-pipeline:schema:shared:0.1.0#/$defs/semanticId" },
        "path": { "$ref": "urn:pptx-pipeline:schema:shared:0.1.0#/$defs/relativePath" }
      }
    },
    "projectPaths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetRoot", "stagingRoot", "outputRoot"],
      "properties": {
        "assetRoot": { "$ref": "urn:pptx-pipeline:schema:shared:0.1.0#/$defs/relativePath" },
        "stagingRoot": { "$ref": "urn:pptx-pipeline:schema:shared:0.1.0#/$defs/relativePath" },
        "outputRoot": { "$ref": "urn:pptx-pipeline:schema:shared:0.1.0#/$defs/relativePath" }
      }
    },
    "projectPolicies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["experimentalCapabilities", "unknownFeatures", "ambiguousBindings", "sourceMutation"],
      "properties": {
        "experimentalCapabilities": { "const": "require-explicit-opt-in" },
        "unknownFeatures": { "const": "reject" },
        "ambiguousBindings": { "const": "reject" },
        "sourceMutation": { "const": "reject" }
      }
    }
  }
}
