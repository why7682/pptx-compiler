{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pptx-compiler:schema:build-artifact:0.1.0",
  "title": "PPTX Compiler BuildArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractType",
    "buildId",
    "projectId",
    "deckId",
    "templateProfileId",
    "templateIndexId",
    "capabilityRegistryId",
    "registryVersion",
    "projectOverlayId",
    "templateSha256",
    "slides",
    "changedParts",
    "qaReportId",
    "output"
  ],
  "properties": {
    "schemaVersion": { "$ref": "urn:pptx-compiler:schema:shared:0.1.0#/$defs/schemaVersion" },
    "contractType": { "const": "build-artifact" },
    "buildId": { "$ref": "urn:pptx-compiler:schema:shared:0.1.0#/$defs/semanticId" },
    "projectId": { "$ref": "urn:pptx-compiler:schema:shared:0.1.0#/$defs/semanticId" },
    "deckId": { "$ref": "urn:pptx-compiler:schema:shared:0.1.0#/$defs/semanticId" },
    "templateProfileId": { "$ref": "urn:pptx-compiler:schema:shared:0.1.0#/$defs/semanticId" },
    "templateIndexId": { "$ref": "urn:pptx-compiler:schema:shared:0.1.0#/$defs/semanticId" },
    "capabilityRegistryId": { "$ref": "urn:pptx-compiler:schema:shared:0.1.0#/$defs/semanticId" },
    "registryVersion": { "$ref": "urn:pptx-compiler:schema:shared:0.1.0#/$defs/semanticVersion" },
    "projectOverlayId": { "$ref": "urn:pptx-compiler:schema:shared:0.1.0#/$defs/semanticId" },
    "templateSha256": { "$ref": "urn:pptx-compiler:schema:shared:0.1.0#/$defs/sha256" },
    "slides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/slideResult" }
    },
    "changedParts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/changedPartPath" }
    },
    "qaReportId": { "$ref": "urn:pptx-compiler:schema:shared:0.1.0#/$defs/semanticId" },
    "output": { "$ref": "#/$defs/publishedOutput" }
  },
  "$defs": {
    "changedPartPath": {
      "oneOf": [
        { "const": "[Content_Types].xml" },
        { "$ref": "urn:pptx-compiler:schema:shared:0.1.0#/$defs/packagePartPath" }
      ]
    },
    "slideResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slideId", "capabilityId", "capabilityVersion"],
      "properties": {
        "slideId": { "$ref": "urn:pptx-compiler:schema:shared:0.1.0#/$defs/semanticId" },
        "capabilityId": { "$ref": "urn:pptx-compiler:schema:shared:0.1.0#/$defs/semanticId" },
        "capabilityVersion": { "$ref": "urn:pptx-compiler:schema:shared:0.1.0#/$defs/semanticVersion" }
      }
    },
    "publishedOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "publishPath", "sha256", "byteLength"],
      "properties": {
        "format": { "const": "pptx" },
        "publishPath": {
          "type": "string",
          "minLength": 6,
          "maxLength": 512,
          "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*\\.pptx$"
        },
        "sha256": { "$ref": "urn:pptx-compiler:schema:shared:0.1.0#/$defs/sha256" },
        "byteLength": { "$ref": "urn:pptx-compiler:schema:shared:0.1.0#/$defs/byteLength" }
      }
    }
  }
}
