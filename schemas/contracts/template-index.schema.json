{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pptx-compiler:schema:template-index:0.1.0",
  "title": "PPTX Compiler TemplateIndex",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractType",
    "templateIndexId",
    "templateProfileId",
    "templateFormat",
    "templateSha256",
    "presentationPart",
    "slideSizeEmu",
    "observedFeatureIds",
    "masters",
    "layouts",
    "slides"
  ],
  "properties": {
    "schemaVersion": { "$ref": "urn:pptx-compiler:schema:shared:0.1.0#/$defs/schemaVersion" },
    "contractType": { "const": "template-index" },
    "templateIndexId": { "$ref": "urn:pptx-compiler:schema:shared:0.1.0#/$defs/semanticId" },
    "templateProfileId": { "$ref": "urn:pptx-compiler:schema:shared:0.1.0#/$defs/semanticId" },
    "templateFormat": { "enum": ["potx", "pptx"] },
    "templateSha256": { "$ref": "urn:pptx-compiler:schema:shared:0.1.0#/$defs/sha256" },
    "presentationPart": { "$ref": "urn:pptx-compiler:schema:shared:0.1.0#/$defs/packagePartPath" },
    "slideSizeEmu": { "$ref": "#/$defs/slideSize" },
    "observedFeatureIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "urn:pptx-compiler:schema:shared:0.1.0#/$defs/semanticId" }
    },
    "masters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/masterEntry" }
    },
    "layouts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2048,
      "items": { "$ref": "#/$defs/layoutEntry" }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/slideEntry" }
    }
  },
  "$defs": {
    "slideSize": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cx", "cy"],
      "properties": {
        "cx": { "$ref": "urn:pptx-compiler:schema:shared:0.1.0#/$defs/emuExtent" },
        "cy": { "$ref": "urn:pptx-compiler:schema:shared:0.1.0#/$defs/emuExtent" }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "cx", "cy"],
      "properties": {
        "x": { "$ref": "urn:pptx-compiler:schema:shared:0.1.0#/$defs/emuCoordinate" },
        "y": { "$ref": "urn:pptx-compiler:schema:shared:0.1.0#/$defs/emuCoordinate" },
        "cx": { "$ref": "urn:pptx-compiler:schema:shared:0.1.0#/$defs/emuExtent" },
        "cy": { "$ref": "urn:pptx-compiler:schema:shared:0.1.0#/$defs/emuExtent" }
      }
    },
    "placeholder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "index"],
      "properties": {
        "type": { "$ref": "urn:pptx-compiler:schema:shared:0.1.0#/$defs/semanticId" },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      }
    },
    "shapeEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shapeKey", "sourceId", "kind", "geometry"],
      "properties": {
        "shapeKey": { "$ref": "urn:pptx-compiler:schema:shared:0.1.0#/$defs/semanticId" },
        "sourceId": { "$ref": "urn:pptx-compiler:schema:shared:0.1.0#/$defs/ooxmlId" },
        "kind": {
          "enum": ["auto-shape", "graphic-frame", "group", "picture", "placeholder", "text-box"]
        },
        "geometry": { "$ref": "#/$defs/geometry" },
        "placeholder": { "$ref": "#/$defs/placeholder" }
      }
    },
    "masterEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["masterKey", "sourceId", "partPath"],
      "properties": {
        "masterKey": { "$ref": "urn:pptx-compiler:schema:shared:0.1.0#/$defs/semanticId" },
        "sourceId": { "$ref": "urn:pptx-compiler:schema:shared:0.1.0#/$defs/ooxmlId" },
        "partPath": { "$ref": "urn:pptx-compiler:schema:shared:0.1.0#/$defs/packagePartPath" }
      }
    },
    "layoutEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layoutKey", "sourceId", "partPath", "masterKey", "shapes"],
      "properties": {
        "layoutKey": { "$ref": "urn:pptx-compiler:schema:shared:0.1.0#/$defs/semanticId" },
        "sourceId": { "$ref": "urn:pptx-compiler:schema:shared:0.1.0#/$defs/ooxmlId" },
        "partPath": { "$ref": "urn:pptx-compiler:schema:shared:0.1.0#/$defs/packagePartPath" },
        "masterKey": { "$ref": "urn:pptx-compiler:schema:shared:0.1.0#/$defs/semanticId" },
        "shapes": {
          "type": "array",
          "maxItems": 8192,
          "items": { "$ref": "#/$defs/shapeEntry" }
        }
      }
    },
    "slideEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slideKey", "sourceId", "partPath", "layoutKey", "shapes"],
      "properties": {
        "slideKey": { "$ref": "urn:pptx-compiler:schema:shared:0.1.0#/$defs/semanticId" },
        "sourceId": { "$ref": "urn:pptx-compiler:schema:shared:0.1.0#/$defs/ooxmlId" },
        "partPath": { "$ref": "urn:pptx-compiler:schema:shared:0.1.0#/$defs/packagePartPath" },
        "layoutKey": { "$ref": "urn:pptx-compiler:schema:shared:0.1.0#/$defs/semanticId" },
        "shapes": {
          "type": "array",
          "maxItems": 8192,
          "items": { "$ref": "#/$defs/shapeEntry" }
        }
      }
    }
  }
}
