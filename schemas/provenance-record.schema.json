{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pptx-compiler:schema:provenance-record:1",
  "title": "PPTX Compiler provenance records",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "records"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "license": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "spdxExpression"
          ],
          "properties": {
            "spdxExpression": {
              "enum": [
                "MIT"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rightsBasis"
          ],
          "properties": {
            "rightsBasis": {
              "enum": [
                "standard-mit-license-text"
              ]
            }
          }
        }
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "notes"
      ],
      "properties": {
        "status": {
          "enum": [
            "not-applicable",
            "passed",
            "pending"
          ]
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "notes"
      ],
      "properties": {
        "status": {
          "enum": [
            "applicable",
            "not-applicable",
            "pending"
          ]
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "origin",
        "copyrightHolderOrSourceAuthority",
        "license",
        "reviewedOn",
        "thirdPartyDependencies",
        "privateInformationReview",
        "projectConstantCleanup",
        "publicConformance",
        "independentReview",
        "notes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[ -~]+$"
        },
        "kind": {
          "enum": [
            "generated",
            "migrated-and-rewritten",
            "new-clean-room",
            "third-party"
          ]
        },
        "origin": {
          "type": "string",
          "minLength": 1
        },
        "copyrightHolderOrSourceAuthority": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "$ref": "#/$defs/license"
        },
        "reviewedOn": {
          "type": "string",
          "format": "date"
        },
        "thirdPartyDependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "privateInformationReview": {
          "$ref": "#/$defs/review"
        },
        "projectConstantCleanup": {
          "$ref": "#/$defs/review"
        },
        "publicConformance": {
          "$ref": "#/$defs/conformance"
        },
        "independentReview": {
          "$ref": "#/$defs/review"
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
