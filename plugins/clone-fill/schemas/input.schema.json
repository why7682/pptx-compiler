{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pptx-compiler:capability:schema:source-slide-clone-fill-input:0.1.0",
  "title": "Source slide clone/fill input",
  "type": "object",
  "additionalProperties": false,
  "required": ["body", "title"],
  "properties": {
    "body": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/bodyParagraph" }
    },
    "title": { "$ref": "#/$defs/titleText" }
  },
  "$defs": {
    "bodyParagraph": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^(?=.*\\S)(?!.*\\p{Cf})(?!.*\\p{Noncharacter_Code_Point})(?!.*[\\uD800-\\uDFFF])[^\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029]+$"
    },
    "titleText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?=.*\\S)(?!.*\\p{Cf})(?!.*\\p{Noncharacter_Code_Point})(?!.*[\\uD800-\\uDFFF])[^\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029]+$"
    }
  }
}
